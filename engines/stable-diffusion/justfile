# Build stable-diffusion.cpp's sd-server example.
# The source is kept outside this repository and fetched at a pinned commit.
set shell := ["bash", "-euo", "pipefail", "-c"]

source_dir := "build/stable-diffusion.cpp"
build_dir := "build/server"
dest := "../../bin/libexec/ai-server"
# Upstream PR #2143 adds FLUX.3 Image Klein; replace with a release once merged.
version := "6d6ff751882e80e8f3af0942c9d4eb4e07375b19"

build variant="cpu" target=dest:
    #!/usr/bin/env bash
    set -euo pipefail
    mkdir -p build
    if [[ ! -d "{{source_dir}}/.git" ]]; then
      git init "{{source_dir}}"
      git -C "{{source_dir}}" remote add origin https://github.com/leejet/stable-diffusion.cpp.git
    fi
    if [[ "$(git -C "{{source_dir}}" rev-parse HEAD 2>/dev/null || true)" != "{{version}}" ]]; then
      if [[ -n "$(git -C "{{source_dir}}" status --porcelain)" ]]; then
        echo "Refusing to update modified engine source: {{source_dir}}" >&2
        exit 1
      fi
      git -C "{{source_dir}}" fetch --depth 1 origin "{{version}}"
      git -C "{{source_dir}}" checkout --detach "{{version}}"
    fi
    test "$(git -C "{{source_dir}}" rev-parse HEAD)" = "{{version}}"
    git -C "{{source_dir}}" submodule update --init --recursive --depth 1
    case "{{variant}}" in
      cpu) cuda=OFF ;;
      cuda-12*|cuda-13*) cuda=ON; export CUDA_HOME="${CUDA_HOME:-/usr/local/{{variant}}}"; export CUDACXX="$CUDA_HOME/bin/nvcc" ;;
      *) echo "variant must be cpu, cuda-12.x or cuda-13.x" >&2; exit 2 ;;
    esac
    rm -rf "{{build_dir}}"
    cmake -S "{{source_dir}}" -B "{{build_dir}}" -G Ninja \
      -DSD_BUILD_EXAMPLES=ON \
      -DSD_SERVER_BUILD_FRONTEND=OFF \
      -DSD_WEBP=ON \
      -DSD_CUDA=$cuda \
      -DGGML_NATIVE=OFF \
      -DCMAKE_BUILD_TYPE=Release
    cmake --build "{{build_dir}}" --target sd-server --parallel "${CMAKE_BUILD_PARALLEL_LEVEL:-2}"
    mkdir -p "{{target}}"
    install -m 0755 "{{build_dir}}/bin/sd-server" "{{target}}/sd-server"
    echo "Installed {{target}}/sd-server ({{variant}})"

clean:
    rm -rf build
