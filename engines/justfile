# Engine dispatcher. Each engine owns its build recipe in a child justfile.

set shell := ["bash", "-euo", "pipefail", "-c"]

mod decider "ggmlc-custom-decider"
mod audioengine "ggmlc-audio"
mod clef "clef"
mod laya "laya"
mod imageengine "stable-diffusion"

default:
    @just --list

# Build all native engines, including the bundled upstream llama-server.
build variant="cuda-13.4" target="":
    #!/usr/bin/env bash
    set -euo pipefail
    if [[ -n "{{target}}" ]]; then
            bundle=$(realpath -m "{{target}}")
            just decider build "{{variant}}" "$bundle"
            just clef build "$bundle"
            just audioengine build "{{variant}}" "$bundle"
            just imageengine build "{{variant}}" "$bundle"
    else
      just decider build "{{variant}}"
      just clef build
            just audioengine build "{{variant}}"
            just imageengine build "{{variant}}"
    fi

deps variant="cuda-13.4":
    just decider deps "{{variant}}"

compile variant="cuda-13.4":
    just decider compile "{{variant}}"
    just clef compile

verify target="../bin/libexec/ai-server" variant="cuda-13.4":
        #!/usr/bin/env bash
        set -euo pipefail
        bundle=$(realpath '{{target}}')
        just decider verify "$bundle" "{{variant}}"
        for engine in laya clef ggmlc-audio sd-server; do
            if [[ ! -x "$bundle/$engine" ]]; then
                echo "ERROR: missing engine executable: $bundle/$engine" >&2
                exit 1
            fi
        done
        echo "All engine executables present"

clean:
    just decider clean
    just clef clean
    just imageengine clean

# Fetch the upstream Laya runtime.
runtime variant="auto" version="v0.9.6":
    just laya fetch "{{variant}}" "{{version}}"

# Build the persistent audio (TTS) engine; variant defaults to the one in the decider deps.
audio variant="" target="../../bin/libexec/ai-server":
    just audioengine build "{{variant}}" "{{target}}"

# Build stable-diffusion.cpp's persistent OpenAI-compatible image server.
image variant="cpu" target="../../bin/libexec/ai-server":
    just imageengine build "{{variant}}" "{{target}}"
