# ggmlc-custom-decider engine build.
#
# Links the prebuilt llama.cpp release libraries (libllama, libmtmd, ggml
# backends); nothing from llama.cpp is compiled and no CUDA toolkit is needed.
#
#   just engine build                      # default: cuda-13.4, installs into ../../bin/libexec/ai-server
#   just engine build vulkan               # or: cuda-13.4, cpu
#   just engine deps cuda-12.8 b11300      # other llama.cpp release
#   just engine deps cuda-13.4             # CUDA 13 runtime
#   just engine clean
#
# Recipes run in this directory (engines/ggmlc-custom-decider).

set shell := ["bash", "-euo", "pipefail", "-c"]

tag       := env_var_or_default("LLAMA_CPP_TAG", "b11256")
deps      := "deps"
build_dir := "build"
dest      := "../../bin/libexec/ai-server"
raw       := "https://raw.githubusercontent.com/ggml-org/llama.cpp/" + tag

default:
    @just --list

# Download prebuilt llama.cpp libraries + matching headers into deps/ (variant: cuda-12.8 | cuda-13.4 | vulkan | cpu)
deps variant="cuda-13.4": (libs variant) headers

# Prebuilt runtime libraries (skipped when deps/ already has this tag+variant)
[private]
libs variant:
    #!/usr/bin/env bash
    set -euo pipefail
    case "{{variant}}" in
      cuda-12.8) asset="llama-{{tag}}-bin-ubuntu-cuda-12.8-x64.tar.gz" ;;
      cuda-13.4) asset="llama-{{tag}}-bin-ubuntu-cuda-13.4-x64.tar.gz" ;;
      vulkan)    asset="llama-{{tag}}-bin-ubuntu-vulkan-x64.tar.gz" ;;
      cpu)       asset="llama-{{tag}}-bin-ubuntu-x64.tar.gz" ;;
      *) echo "unknown variant {{variant}} (cuda-12.8 | cuda-13.4 | vulkan | cpu)" >&2; exit 1 ;;
    esac
    complete=true
    for lib in libllama.so libllama-common.so libllama-server-impl.so libmtmd.so libggml.so libggml-base.so libggml-cpu-x64.so; do
      [[ -e "{{deps}}/lib/$lib" ]] || complete=false
    done
    case "{{variant}}" in
      cuda-*) [[ -e {{deps}}/lib/libggml-cuda.so ]] || complete=false ;;
      vulkan) [[ -e {{deps}}/lib/libggml-vulkan.so ]] || complete=false ;;
    esac
    if [[ -f {{deps}}/.tag && "$(cat {{deps}}/.tag)" == "{{tag}}-{{variant}}" && "$complete" == true && -x {{deps}}/llama-server ]]; then
      echo "deps/lib up to date ({{tag}}, {{variant}})"; exit 0
    fi
    tmp=$(mktemp -d); trap 'rm -rf "$tmp"' EXIT
    echo "Fetching $asset"
    curl -fL --progress-bar -o "$tmp/l.tgz" "https://github.com/ggml-org/llama.cpp/releases/download/{{tag}}/$asset"
    tar -xzf "$tmp/l.tgz" -C "$tmp"
    src=$(find "$tmp" -maxdepth 2 -name 'libllama.so*' -printf '%h\n' | head -1)
    rm -rf {{deps}}/lib && mkdir -p {{deps}}/lib
    cp -P "$src"/lib*.so* {{deps}}/lib/
    install -m 0755 "$src/llama-server" {{deps}}/llama-server
    echo "{{tag}}-{{variant}}" > {{deps}}/.tag
    echo "deps/lib ready: $(ls {{deps}}/lib | wc -l) files"

# Public headers of the same llama.cpp tag + nlohmann/json; common/ headers (chat templates, sampler) for the text engine
[private]
headers:
    #!/usr/bin/env bash
    set -euo pipefail
    # Headers are only valid for the tag they were fetched with.
    if [[ "$(cat {{deps}}/include/.tag 2>/dev/null)" != "{{tag}}" ]]; then rm -rf {{deps}}/include; fi
    mkdir -p {{deps}}/include/nlohmann {{deps}}/include/common/jinja
    echo "{{tag}}" > {{deps}}/include/.tag
    for f in common.h chat.h sampling.h peg-parser.h json.h json-schema.h \
             jinja/parser.h jinja/runtime.h jinja/caps.h jinja/lexer.h jinja/utils.h jinja/value.h jinja/string.h; do
      out={{deps}}/include/common/$f
      [[ -s "$out" ]] || curl -fsSL -o "$out" "{{raw}}/common/$f"
    done
    for f in include/llama.h include/llama-cpp.h \
             ggml/include/ggml.h ggml/include/ggml-backend.h ggml/include/ggml-alloc.h \
             ggml/include/ggml-cpu.h ggml/include/ggml-opt.h ggml/include/gguf.h \
             tools/mtmd/mtmd.h tools/mtmd/mtmd-helper.h; do
      out={{deps}}/include/$(basename "$f")
      [[ -s "$out" ]] || curl -fsSL -o "$out" "{{raw}}/$f"
    done
    out={{deps}}/include/nlohmann/json.hpp
    [[ -s "$out" ]] || curl -fsSL -o "$out" "{{raw}}/vendor/nlohmann/json.hpp"

# Compile main.cpp against deps/ (Release, Ninja)
compile variant="cuda-13.4": (deps variant)
    #!/usr/bin/env bash
    set -euo pipefail
    test -f {{deps}}/.tag && test "$(cat {{deps}}/.tag)" = "{{tag}}-{{variant}}"
    rm -rf {{build_dir}}
    cmake -S . -B {{build_dir}} -G Ninja -DCMAKE_BUILD_TYPE=Release > /dev/null
    cmake --build {{build_dir}}

# Build and install the engine + libraries into the bundle (default: bin/libexec/ai-server)
build variant="cuda-13.4" target=dest: (compile variant) && (verify target variant)
    mkdir -p {{target}}/lib
    install -m 0755 {{build_dir}}/ggmlc-custom-decider {{target}}/ggmlc-custom-decider
    install -m 0755 {{deps}}/llama-server {{target}}/llama-server
    cp -P {{deps}}/lib/*.so* {{target}}/lib/
    for backend in "{{target}}"/lib/libggml-*.so*; do ln -sf "lib/$(basename "$backend")" "{{target}}/$(basename "$backend")"; done
    @echo "Installed {{target}}/ggmlc-custom-decider"

# Check the upstream server bundle and warn about missing host shared libraries.
verify target=dest variant="cuda-13.4":
    #!/usr/bin/env bash
    set -euo pipefail
    cd {{target}}
    test -x ggmlc-custom-decider
    test -x llama-server
    for lib in libllama.so libllama-common.so libllama-server-impl.so libmtmd.so libggml.so libggml-base.so libggml-cpu-x64.so; do
      test -e "lib/$lib"
    done
    case "{{variant}}" in
      cuda-*) test -e lib/libggml-cuda.so ;;
      vulkan) test -e lib/libggml-vulkan.so ;;
    esac
    for backend in lib/libggml-*.so*; do
      test -L "$(basename "$backend")"
      test "$(readlink "$(basename "$backend")")" = "$backend"
      test -e "$(basename "$backend")"
    done
    missing=$(LD_LIBRARY_PATH=lib ldd ggmlc-custom-decider llama-server lib/libllama-server-impl.so 2>/dev/null | grep 'not found' | sort -u || true)
    if [[ -n "$missing" ]]; then
      echo "WARNING: missing shared libraries:" >&2
      echo "$missing" >&2
      if [[ "{{variant}}" == cuda-* ]]; then
        echo "Run 'just runtime' in the repo root to bundle the CUDA runtime into $(pwd)/lib" >&2
      else
        echo "Install the runtime libraries required by the {{variant}} build" >&2
      fi
    else
      echo "All shared libraries resolved"
    fi

# Remove build output and downloaded deps
clean:
    rm -rf {{build_dir}} {{deps}}
